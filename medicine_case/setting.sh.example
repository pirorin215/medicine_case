#!/bin/bash
# Medicine Case 設定ファイル
# 各スクリプトから source コマンドで読み込まれます

#=============================================================================
# シリアルポート設定（必須）
#=============================================================================
# XIAO BLE Sense デバイスのシリアルポートを指定してください
# 自動検出を廃止し、明示的に指定することで、意図しないデバイスへの
# ファームウェア書き込みやログ出力を防ぐためです
#
# 設定例:
#   MEDICINE_CASE_PORT="/dev/cu.usbmodem2101"
#   MEDICINE_CASE_PORT="/dev/cu.usbmodem1301"
#   MEDICINE_CASE_PORT="/dev/tty.usbmodem2101"
#   MEDICINE_CASE_PORT="/dev/ttyUSB0"
#
# 未設定の場合はエラーで終了します
#=============================================================================

MEDICINE_CASE_PORT="/dev/cu.usbmodemXXXX"

#=============================================================================
# その他の設定（将来の拡張用）
#=============================================================================
# ここに他の設定変数を追加できます
