#!/bin/bash
# Medicine Case Pro Micro 設定ファイル
# 各スクリプトから source コマンドで読み込まれます

#=============================================================================
# シリアルポート設定（必須）
#=============================================================================
# ポートは glob でなく明示的に指定すること（~/dev/Arduino/AGENTS.md §8）
#
# 設定例（開発中は開発共通ポート 212101 を使う）:
#   MEDICINE_CASE_PROMICRO_PORT="/dev/cu.usbmodem212101"
#
# 未設定の場合はエラーで終了します
#=============================================================================

MEDICINE_CASE_PROMICRO_PORT=""
